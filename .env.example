# Which model provider to use: anthropic or gemini
LLM_PROVIDER=anthropic

# Claude (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=...
MODEL_NAME=claude-sonnet-5-5
# Optional: how hard Claude thinks (low / medium / high). Default: medium
EFFORT=medium

# Gemini (LLM_PROVIDER=gemini) - key from https://aistudio.google.com/apikey
# Free tier: about 5 requests/minute and 20 requests/day for each model; one message
# uses 2-3 requests. Each model has its own quota (e.g. gemini-3.5-flash).
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.6-flash
# Optional: less thinking = faster replies (minimal / low / medium / high). Empty = model default
GEMINI_THINKING=

LARGE_AMOUNT_IQD=1000000
# Optional: path of the SQLite file (default: debt.db in the project folder)
DB_PATH=debt.db
