# Which model provider to use: anthropic or gemini
LLM_PROVIDER=anthropic

# Claude (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=...
MODEL_NAME=claude-sonnet-5-5
# Optional: how hard Claude thinks (low / medium / high). Default: medium
EFFORT=medium

# Gemini (LLM_PROVIDER=gemini) - key from https://aistudio.google.com/apikey
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash

LARGE_AMOUNT_IQD=1000000
# Optional: path of the SQLite file (default: debt.db in the project folder)
DB_PATH=debt.db
