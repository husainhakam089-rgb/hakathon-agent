# Which model provider to use: anthropic or gemini
LLM_PROVIDER=anthropic

# Claude (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=...
MODEL_NAME=claude-sonnet-5-5
# Optional: how hard Claude thinks (low / medium / high). Default: medium
EFFORT=medium

# Gemini (LLM_PROVIDER=gemini) - key from https://aistudio.google.com/apikey
# Free tier: about 5 requests/minute and 20 requests/day for each model; one message
# uses 2-3 requests. Each model has its own quota (e.g. gemini-3.5-flash).
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.6-flash
# Optional: models to switch to when the one above runs out of its daily quota or is busy
# (comma separated). Empty line = the built-in list; GEMINI_FALLBACK_MODELS= with nothing = no switching
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash
# Optional: less thinking = faster replies (minimal / low / medium / high). Empty = model default
GEMINI_THINKING=

LARGE_AMOUNT_IQD=1000000
# Optional: path of the SQLite file (default: debt.db in the project folder)
DB_PATH=debt.db
# Optional: where the daily backups go (default: the backups folder in the project).
# Best on another drive: a USB stick or a Google Drive / OneDrive folder, e.g. D:\debt-backups
# BACKUP_DIR=

# ----- Stage 22: online, Zain Cash, reminders, the daily report (all optional) -----
# A password for the program. Needed for HOST=0.0.0.0 (the phone on the shop's Wi-Fi) and online.
# APP_PASSWORD=
# HOST=0.0.0.0
# The address customers open payment links on, once it is online, e.g. https://debt-agent.onrender.com
# BASE_URL=
# Real Zain Cash (merchant account). Without these the payment page is a clear test (no money moves).
# ZAINCASH_MERCHANT_ID=
# ZAINCASH_SECRET=
# ZAINCASH_MSISDN=
# ZAINCASH_ENV=test
# The daily report to your Telegram: make a bot with @BotFather, send it a message, then put
# the bot token and your chat id here. Without them the report is kept in the program.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
